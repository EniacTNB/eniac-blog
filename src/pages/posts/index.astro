---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";

const posts = (
  await getCollection("posts", ({ data }) => data.publish)
).sort(
  (a, b) =>
    b.data.date.getTime() - a.data.date.getTime()
);

const base = import.meta.env.BASE_URL;

const postUrl = (id: string) => {
  const slug = id
    .replace(/\/index\.md$/, "")
    .replace(/\/index$/, "");

  return `${base}/posts/${slug}/`.replace(/\/+/g, "/");
};

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  })
    .format(date)
    .replaceAll("/", "-");
---

<BaseLayout
  title="文章"
  description="ENIAC.LOG 全部技术文章"
>
  <SiteHeader />

  <main class="page-shell archive">
    <header class="archive-header">
      <p class="eyebrow">ALL FIELD NOTES</p>
      <h1>文章</h1>
      <p>关于人工智能、复杂系统与产品工程的持续记录。</p>
    </header>

    <ol class="archive-list">
      {
        posts.map((post, index) => (
          <li>
            <a href={postUrl(post.id)}>
              <span class="number">
                {String(index + 1).padStart(2, "0")}
              </span>

              <span class="content">
                <span class="tags">
                  {post.data.tags.length > 0
                    ? post.data.tags.join(" / ")
                    : "技术思考"}
                </span>

                <strong>{post.data.title}</strong>

                {post.data.description && (
                  <span class="description">
                    {post.data.description}
                  </span>
                )}
              </span>

              <time datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
            </a>
          </li>
        ))
      }
    </ol>
  </main>
</BaseLayout>

<style>
  .archive {
    padding-bottom: 80px;
  }

  .archive-header {
    padding: 80px 0 58px;
    border-bottom: 2px solid var(--ink);
  }

  .archive-header h1 {
    margin: 8px 0 16px;
    font-family: var(--font-display);
    font-size: clamp(4rem, 9vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .archive-header > p:last-child {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.08rem;
  }

  .archive-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .archive-list li {
    border-bottom: 1px solid var(--line-strong);
  }

  .archive-list a {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr) 120px;
    align-items: start;
    gap: 28px;
    padding: 27px 0;
  }

  .number {
    color: var(--coral);
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 1;
  }

  .content {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .tags {
    margin-bottom: 5px;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .content strong {
    font-family: var(--font-display);
    font-size: 1.55rem;
    line-height: 1.3;
  }

  .description {
    max-width: 760px;
    margin-top: 8px;
    color: var(--ink-soft);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  time {
    padding-top: 5px;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-align: right;
  }

  .archive-list a:hover strong,
  .archive-list a:focus-visible strong {
    color: var(--coral);
  }

  @media (max-width: 720px) {
    .archive-header {
      padding: 54px 0 40px;
    }

    .archive-list a {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 14px;
    }

    .content strong {
      font-size: 1.25rem;
    }

    time {
      display: none;
    }
  }
</style>
