---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";

const posts = await getCollection(
  "posts",
  ({ data }) => data.publish
);

const tagCounts = new Map<string, number>();

for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(
      tag,
      (tagCounts.get(tag) ?? 0) + 1
    );
  }
}

const topics = Array.from(tagCounts.entries())
  .map(([name, count]) => ({
    name,
    count,
  }))
  .sort(
    (a, b) =>
      b.count - a.count ||
      a.name.localeCompare(b.name, "zh-CN")
  );

const base = import.meta.env.BASE_URL;

const searchURL = (topic: string) =>
  `${base}/search/?q=${encodeURIComponent(topic)}`
    .replace(/([^:])\/\/+/g, "$1/");
---

<BaseLayout
  title="笔记"
  description="按照主题组织的 ENIAC.LOG 技术笔记索引"
>
  <SiteHeader />

  <main class="page-shell section-page">
    <header class="page-intro">
      <p class="eyebrow">KNOWLEDGE INDEX</p>
      <h1>笔记</h1>

      <p>
        这里不是另一套独立内容,而是根据公开文章标签自动形成的知识入口。
        新文章加入标签后,主题索引会自动更新。
      </p>
    </header>

    {
      topics.length > 0 ? (
        <section class="topic-grid">
          {topics.map((topic, index) => (
            <a
              class="topic"
              href={searchURL(topic.name)}
            >
              <span class="topic-number">
                {String(index + 1).padStart(2, "0")}
              </span>

              <h2>{topic.name}</h2>

              <span class="topic-count">
                {topic.count} 篇文章
              </span>
            </a>
          ))}
        </section>
      ) : (
        <section class="empty-topics">
          <p class="eyebrow">NO TOPICS YET</p>
          <h2>主题索引正在形成。</h2>
          <p>
            在文章 frontmatter 中添加 tags,
            主题会自动出现在这里。
          </p>
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .topic-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line-strong);
    border-left: 1px solid var(--line-strong);
  }

  .topic {
    min-height: 210px;
    padding: 25px;
    border-right: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .topic-number {
    color: var(--coral);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .topic h2 {
    margin: 50px 0 10px;
    font-family: var(--font-display);
    font-size: 1.8rem;
    line-height: 1.15;
  }

  .topic-count {
    color: var(--ink-soft);
    font-size: 0.75rem;
  }

  .topic:hover,
  .topic:focus-visible {
    color: var(--paper);
    background: var(--ink);
  }

  .topic:hover .topic-count,
  .topic:focus-visible .topic-count {
    color: rgba(251, 248, 239, 0.65);
  }

  .empty-topics {
    padding: 70px 0;
    text-align: center;
  }

  .empty-topics h2 {
    font-family: var(--font-display);
    font-size: 2rem;
  }

  .empty-topics > p:last-child {
    color: var(--ink-soft);
  }

  @media (max-width: 900px) {
    .topic-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .topic-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
