---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";

const posts = (
  await getCollection("posts", ({ data }) => data.publish)
).sort(
  (a, b) =>
    b.data.date.getTime() - a.data.date.getTime()
);

const featured =
  posts.find((post) => post.data.featured) ?? posts[0];

const latestPosts = posts.slice(0, 3);

const base = import.meta.env.BASE_URL;

const withBase = (value = "") =>
  `${base}/${value}`.replace(/\/+/g, "/");

const postSlug = (id: string) =>
  id.replace(/\/index\.md$/, "").replace(/\/index$/, "");

const postUrl = (id: string) =>
  withBase(`posts/${postSlug(id)}/`);

const paintSwatchUrl = withBase(
  "assets/paint-swatch-mask.png"
);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  })
    .format(date)
    .replaceAll("/", "-");

const readingMinutes = (body = "") => {
  const chineseCount =
    body.match(/[㐀-鿿]/g)?.length ?? 0;

  const englishCount =
    body
      .replace(/[㐀-鿿]/g, " ")
      .match(/[a-zA-Z0-9]+/g)?.length ?? 0;

  return Math.max(
    1,
    Math.ceil((chineseCount + englishCount) / 300)
  );
};
---

<BaseLayout
  title="ENIAC.LOG"
  description="关于人工智能、复杂系统与产品工程的技术博客"
>
  <SiteHeader />

  <main id="main-content" tabindex="-1" class="page-shell">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">本期主文</p>

        <h1>
          {
            featured?.data.title ??
              "在复杂世界里，建立清晰的技术坐标。"
          }
        </h1>

        <p class="hero-description">
          {
            featured?.data.description ??
              "记录人工智能、复杂系统与产品工程中的实践、判断与长期思考。"
          }
        </p>

        {
          featured ? (
            <a
              class="text-link"
              href={postUrl(featured.id)}
            >
              阅读全文
              <span aria-hidden="true">→</span>
            </a>
          ) : (
            <a class="text-link" href="#latest">
              查看文章
              <span aria-hidden="true">→</span>
            </a>
          )
        }
      </div>

      <div class="hero-art">
        {
          featured?.data.cover ? (
            <Image
              class="hero-image"
              src={featured.data.cover}
              alt={
                featured.data.coverAlt ??
                `${featured.data.title}的文章封面`
              }
              widths={[640, 960, 1280, 1600]}
              sizes="(max-width: 1020px) 100vw, 62vw"
              format="webp"
              quality={82}
              loading="eager"
              fetchpriority="high"
              style={`object-position: ${featured.data.coverFocus};`}
            />
          ) : (
            <img
              class="hero-image"
              src={withBase(
                "assets/hero-collaboration.webp"
              )}
              alt="多人围绕知识图谱、数据和推理结果展开协作的手绘插画"
              width="1600"
              height="720"
              loading="eager"
              fetchpriority="high"
            />
          )
        }
      </div>
    </section>

    <section class="manifesto">
      <blockquote>
        <span class="quote-mark" aria-hidden="true">“</span>

        <p>
          工具会过时，框架会重构，<br />
          但思考方式，决定我们能走多远。
        </p>

        <footer>— Eniac</footer>
      </blockquote>

      <div class="about">
        <p class="eyebrow">关于我</p>

        <h2>你好，我是 Eniac。</h2>

        <p>
          一名关注人工智能、复杂系统与产品工程的技术实践者。
        </p>

        <a class="text-link" href={withBase("about/")}>
          了解更多
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section class="latest" id="latest">
      <div class="section-heading">
        <h2>最新文章</h2>

        <a href={withBase("posts/")}>
          查看全部文章
          <span aria-hidden="true">→</span>
        </a>
      </div>

      {
        latestPosts.length > 0 ? (
          <ol class="post-list">
            {latestPosts.map((post, index) => (
              <li>
                <a
                  class="post-row"
                  href={postUrl(post.id)}
                >
                  <span class="post-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span
                    class:list={[
                      "post-mark",
                      `post-mark-${(index % 3) + 1}`,
                    ]}
                    aria-hidden="true"
                  />

                  <span class="post-main">
                    <span class="post-tags">
                      {post.data.tags.length > 0
                        ? post.data.tags.join(" / ")
                        : "技术思考"}
                    </span>

                    <strong>{post.data.title}</strong>
                  </span>

                  <time datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date)}
                  </time>

                  <span class="reading-time">
                    {readingMinutes(post.body)} 分钟阅读
                  </span>

                  <span class="post-arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <div class="empty-state">
            <p class="eyebrow">WAITING FOR NOTES</p>
            <h3>第一篇文章正在路上。</h3>
            <p>
              在 Obsidian 文章中设置
              <code>publish: true</code>
              后，它就会出现在这里。
            </p>
          </div>
        )
      }
    </section>
  </main>
</BaseLayout>

<style define:vars={{ paintSwatchUrl: `url(${paintSwatchUrl})` }}>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns:
      minmax(340px, 0.82fr)
      minmax(520px, 1.35fr);
    min-height: 510px;
    border-bottom: 2px solid var(--ink);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    align-self: center;
    padding: 66px 0 76px;
  }

  .hero h1 {
    max-width: 700px;
    margin: 18px 0 24px;
    font-family: var(--font-display);
    font-size: clamp(3rem, 5vw, 5.4rem);
    font-weight: 760;
    line-height: 1.05;
    letter-spacing: -0.055em;
  }

  .hero-description {
    max-width: 620px;
    margin: 0 0 30px;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.3vw, 1.18rem);
    line-height: 1.9;
  }

  .hero-art {
    align-self: stretch;
    min-width: 0;
    overflow: hidden;
  }

  .hero-art :global(.hero-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 6px;
    color: var(--coral-text);
    border-bottom: 2px solid var(--coral);
    font-weight: 700;
  }

  .text-link span {
    transition: transform 180ms ease;
  }

  .text-link:hover span,
  .text-link:focus-visible span {
    transform: translateX(5px);
  }

  .manifesto {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    padding: 24px 0;
    border-bottom: 1px solid var(--line-strong);
  }

  blockquote {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    column-gap: 14px;
    margin: 0;
    padding: 10px 68px 8px 8px;
    border-right: 1px solid var(--line-strong);
  }

  .quote-mark {
    position: static;
    grid-column: 1;
    grid-row: 1 / span 2;
    align-self: start;
    margin-top: -8px;
    color: var(--coral);
    font-family: Georgia, serif;
    font-size: 4.25rem;
    line-height: 1;
  }

  blockquote p,
  blockquote footer {
    grid-column: 2;
  }

  blockquote p {
    margin: 0;
    font-size: 1.08rem;
    font-weight: 570;
    line-height: 1.8;
  }

  blockquote footer {
    margin-top: 9px;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .about {
    padding: 8px 0 8px 74px;
  }

  .about h2 {
    margin: 5px 0 2px;
    font-family: var(--font-display);
    font-size: 1.8rem;
    letter-spacing: -0.02em;
  }

  .about > p:not(.eyebrow) {
    margin: 0 0 7px;
    color: var(--ink-soft);
  }

  .about .text-link {
    font-size: 0.82rem;
  }

  .latest {
    padding: 17px 0 52px;
  }

  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 5px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 0.92rem;
  }

  .section-heading a {
    display: inline-flex;
    gap: 16px;
    font-size: 0.8rem;
    font-weight: 650;
  }

  .section-heading a span {
    color: var(--coral);
  }

  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-list li {
    border-bottom: 1px solid var(--line-strong);
  }

  .post-row {
    display: grid;
    grid-template-columns:
      54px 132px minmax(260px, 1fr)
      110px 100px 24px;
    align-items: center;
    gap: 20px;
    min-height: 70px;
  }

  .post-number {
    color: var(--coral);
    font-family: var(--font-display);
    font-size: 2.25rem;
    line-height: 1;
  }

  .post-mark {
    display: block;
    width: 124px;
    height: 35px;
    background-color: var(--coral);
    -webkit-mask: var(--paintSwatchUrl) center / contain no-repeat;
    mask: var(--paintSwatchUrl) center / contain no-repeat;
  }

  .post-mark-2 {
    background-color: var(--cornflower);
  }

  .post-mark-3 {
    background-color: var(--ink);
  }

  .post-main {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .post-tags {
    overflow: hidden;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.03em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .post-main strong {
    overflow: hidden;
    font-size: 1rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .post-row time,
  .reading-time {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    white-space: nowrap;
  }

  .post-arrow {
    color: var(--coral);
    font-size: 1.4rem;
    transition: transform 180ms ease;
  }

  .post-row:hover .post-arrow,
  .post-row:focus-visible .post-arrow {
    transform: translateX(5px);
  }

  .empty-state {
    margin-top: 18px;
    padding: 60px 20px;
    text-align: center;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .empty-state h3 {
    margin: 8px 0;
    font-family: var(--font-display);
    font-size: 2rem;
  }

  .empty-state p {
    color: var(--ink-soft);
  }

  .empty-state code {
    color: var(--coral-text);
    font-family: var(--font-mono);
  }

  @media (max-width: 1020px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-copy {
      padding-bottom: 28px;
    }

    .hero-art {
      height: 420px;
    }

    .post-row {
      grid-template-columns:
        48px 90px minmax(240px, 1fr)
        100px 24px;
    }

    .post-mark {
      width: 84px;
    }

    .reading-time {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .hero-copy {
      padding: 54px 0 24px;
    }

    .hero h1 {
      font-size: clamp(2.7rem, 12vw, 4.3rem);
    }

    .hero-art {
      height: 300px;
      margin-inline: -14px;
    }

    .manifesto {
      grid-template-columns: 1fr;
    }

    blockquote {
      grid-template-columns: 34px minmax(0, 1fr);
      column-gap: 10px;
      padding: 16px 8px 26px 2px;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .quote-mark {
      margin-top: -4px;
      font-size: 3.75rem;
    }

    .about {
      padding: 25px 0 10px;
    }

    .post-row {
      grid-template-columns: 42px minmax(0, 1fr) 20px;
      gap: 12px;
      padding: 17px 0;
    }

    .post-mark,
    .post-row time,
    .reading-time {
      display: none;
    }

    .post-number {
      font-size: 1.75rem;
    }

    .post-main strong {
      white-space: normal;
      line-height: 1.45;
    }
  }
</style>
