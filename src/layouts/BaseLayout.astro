---
import "@fontsource-variable/noto-sans-sc";
import "@fontsource-variable/roboto-condensed";
import "@fontsource-variable/roboto-mono";
import "../styles/global.css";
import "../styles/section-page.css";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date | string;
  tags?: string[];
  noindex?: boolean;
}

const {
  title = "ENIAC.LOG",
  description =
    "关于人工智能、复杂系统与产品工程的技术博客",
  image,
  type = "website",
  publishedTime,
  tags = [],
  noindex = false,
} = Astro.props;

const pageTitle =
  title === "ENIAC.LOG"
    ? "ENIAC.LOG · 技术与复杂系统笔记"
    : `${title} · ENIAC.LOG`;

const productionSite =
  Astro.site ?? new URL(Astro.url.origin);

const canonicalURL = new URL(
  Astro.url.pathname,
  productionSite
);

const base = import.meta.env.BASE_URL;

const withBase = (value: string) =>
  `${base}/${value}`.replace(/\/+/g, "/");

const defaultImagePath = withBase("assets/hero-collaboration.png");

const socialImageURL = new URL(
  image ?? defaultImagePath,
  productionSite
);

const rssURL = new URL(
  withBase("rss.xml"),
  productionSite
);

const sitemapURL = new URL(
  withBase("sitemap-index.xml"),
  productionSite
);

const publishedISOString = publishedTime
  ? new Date(publishedTime).toISOString()
  : undefined;

const structuredData =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        image: socialImageURL.href,
        datePublished: publishedISOString,
        dateModified: publishedISOString,
        inLanguage: "zh-CN",
        mainEntityOfPage: canonicalURL.href,
        author: {
          "@type": "Person",
          name: "Eniac",
        },
        publisher: {
          "@type": "Person",
          name: "Eniac",
        },
        keywords: tags.join(", "),
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "ENIAC.LOG",
        description,
        url: canonicalURL.href,
        inLanguage: "zh-CN",
        author: {
          "@type": "Person",
          name: "Eniac",
        },
      };
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{pageTitle}</title>

    <meta name="description" content={description} />
    <meta name="author" content="Eniac" />
    <meta name="theme-color" content="#fbf8ef" />

    {
      noindex ? (
        <meta
          name="robots"
          content="noindex, nofollow"
        />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large"
        />
      )
    }

    <link
      rel="canonical"
      href={canonicalURL.href}
    />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="ENIAC.LOG RSS"
      href={rssURL.href}
    />

    <link
      rel="sitemap"
      href={sitemapURL.href}
    />

    <meta property="og:site_name" content="ENIAC.LOG" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta
      property="og:description"
      content={description}
    />
    <meta
      property="og:url"
      content={canonicalURL.href}
    />
    <meta
      property="og:image"
      content={socialImageURL.href}
    />
    <meta
      property="og:image:alt"
      content={`${title} - ENIAC.LOG`}
    />

    {
      publishedISOString && (
        <meta
          property="article:published_time"
          content={publishedISOString}
        />
      )
    }

    {
      tags.map((tag) => (
        <meta
          property="article:tag"
          content={tag}
        />
      ))
    }

    <meta
      name="twitter:card"
      content="summary_large_image"
    />
    <meta
      name="twitter:title"
      content={pageTitle}
    />
    <meta
      name="twitter:description"
      content={description}
    />
    <meta
      name="twitter:image"
      content={socialImageURL.href}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    <meta
      name="google-site-verification"
      content="D9hx49hUXztNuWWk_NHr5VKJ5tdT3m3pN4gnTx1pNQY"
    />

    <meta
      name="msvalidate.01"
      content="7E726529E31BA0DB03D61932C056193D"
    />

    {
      import.meta.env.PROD && (
        <>
          <script
            is:inline
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-EWWXBTE6R2"
          />
          <script is:inline>
            {`
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              gtag('js', new Date());
              gtag('config', 'G-EWWXBTE6R2', { anonymize_ip: true });
            `}
          </script>
        </>
      )
    }
  </head>

  <body>
    <slot />
    <SiteFooter />
  </body>
</html>
